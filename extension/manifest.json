{
  "manifest_version": 3,
  "name": "Blindspot for Chrome",
  "version": "0.1.0",
  "description": "Locally scans the current page for static AI security indicators when you click the extension.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Blindspot — scan this page"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
